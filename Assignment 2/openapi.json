    "/issues": {
      "get": {
        "summary": "List Issues Endpoint",
        "description": "Return issues from the configured GitHub repository.",
        "operationId": "list_issues",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "open",
                "closed",
                "all"
              ],
              "type": "string",
              "default": "open",
              "title": "State"
            }
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Labels"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 30,
              "title": "Per Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issues returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IssueResponse"
                  },
                  "title": "Response List Issues"
                },
                "example": [
                  {
                    "number": 4,
                    "html_url": "https://github.com/ChanghyunKim-sjsu/CMPE-272-issues-test/issues/4",
                    "state": "open",
                    "title": "Example issue",
                    "body": "Created through the CMPE 272 Issues Gateway.",
                    "labels": [
                      "bug"
                    ],
                    "created_at": "2026-09-05T20:15:00Z",
                    "updated_at": "2026-09-05T20:15:00Z"
                  }
                ]
              }
            },
            "headers": {
              "Link": {
                "description": "GitHub pagination links",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Request correlation identifier",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "example": {
                  "error": "validation_error",
                  "message": "Invalid request",
                  "status_code": 400
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "GitHub authentication failed",
            "content": {
              "application/json": {
                "example": {
                  "error": "github_api_error",
                  "message": "Bad credentials",
                  "status_code": 401
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "GitHub API rate limit exceeded",
            "content": {
              "application/json": {
                "example": {
                  "error": "github_api_error",
                  "message": "GitHub API rate limit exceeded",
                  "status_code": 429
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },

              "application/json": {
                "example": {
                  "error": "github_api_error",
                  "message": "Issue not found",
                  "status_code": 404
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "GitHub API rate limit exceeded",
            "content": {
              "application/json": {
                "example": {
                  "error": "github_api_error",
                  "message": "GitHub API rate limit exceeded",
                  "status_code": 429
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }

  "paths": {
    "/issues/{number}": {
      "get": {
        "summary": "Get Issue Endpoint",
        "description": "Return a single issue by issue number.",
        "operationId": "get_issue",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issue returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueResponse"
                },
                "example": {
                  "number": 4,
                  "html_url": "https://github.com/ChanghyunKim-sjsu/CMPE-272-issues-test/issues/4",
                  "state": "open",
                  "title": "Example issue",
                  "body": "Created through the CMPE 272 Issues Gateway.",
                  "labels": [
                    "bug"
                  ],
                  "created_at": "2026-09-05T20:15:00Z",
                  "updated_at": "2026-09-05T20:15:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Invalid issue number",
            "content": {
              "application/json": {
                "example": {
                  "error": "validation_error",
                  "message": "Invalid request",
                  "status_code": 400
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "GitHub authentication failed",
            "content": {
              "application/json": {
                "example": {
                  "error": "github_api_error",
                  "message": "Bad credentials",
                  "status_code": 401
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Issue not found",

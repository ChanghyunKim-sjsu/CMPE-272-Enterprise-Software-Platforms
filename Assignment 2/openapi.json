        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "IssueCreate",
        "description": "Request model for creating a GitHub issue.",
        "examples": [
          {
            "body": "Created through the CMPE 272 Issues Gateway.",
            "labels": [
              "bug",
